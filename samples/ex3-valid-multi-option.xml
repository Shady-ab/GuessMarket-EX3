<?xml version="1.0" encoding="UTF-8"?>
<Guess-Market xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="GM-EX3-Schema.xsd">
  <GM-events>
    <GM-event name="World Cup 2026 Champion">
      <description>Which national team will win the 2026 World Cup final?</description>
      <commission type="on-purchase">2</commission>
      <GM-options>
        <GM-option>Argentina</GM-option>
        <GM-option>France</GM-option>
        <GM-option>Brazil</GM-option>
        <GM-option>Spain</GM-option>
      </GM-options>
      <GM-method>
        <GM-LMSR>
          <b>100</b>
        </GM-LMSR>
      </GM-method>
    </GM-event>
    <GM-event name="Tel Aviv Weather Saturday">
      <description>What will the weather be in Tel Aviv on Saturday at noon?</description>
      <comision type="on-close">5</comision>
      <GM-options>
        <GM-option>Sunny</GM-option>
        <GM-option>Cloudy</GM-option>
        <GM-option>Rainy</GM-option>
      </GM-options>
      <GM-method>
        <GM-order-book allow-mint="true" inital="300" d="3"/>
      </GM-method>
    </GM-event>
  </GM-events>
</Guess-Market>
